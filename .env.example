# Copy to .env and keep it private. Orders remain disabled.
# Telegram can also be configured through first-run onboarding: ./start.sh
TRADEBOT_OPENROUTER_API_KEY=
TRADEBOT_NVIDIA_API_KEY=
TRADEBOT_TELEGRAM_BOT_TOKEN=
# Optional when already known; otherwise use --telegram-pair in a private chat.
TRADEBOT_TELEGRAM_CHAT_ID=
TRADEBOT_ALPACA_API_KEY=
TRADEBOT_ALPACA_SECRET_KEY=
TRADEBOT_X_BEARER_TOKEN=
TRADEBOT_TAVILY_API_KEY=
TRADEBOT_SEC_USER_AGENT=YourCompany contact@example.com

